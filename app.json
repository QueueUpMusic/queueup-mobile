{
  "expo": {
    "name": "QueueUp",
    "slug": "queueup-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/queueup-icon.png",
    "scheme": "queueupmobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/queueup-icon.png",
      "bundleIdentifier": "com.queueupmusic.queueup"
    },
    "android": {
      "package": "com.queueupmusic.queueup",
      "adaptiveIcon": {
        "backgroundColor": "#07100c",
        "foregroundImage": "./assets/images/queueup-icon.png",
        "monochromeImage": "./assets/images/queueup-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/queueup-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07100c",
          "image": "./assets/images/queueup-logo.png",
          "imageWidth": 144,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "photosPermission": "QueueUp uses your photos for your profile picture."
        }
      ],
      "expo-audio",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a536c245-89b4-48d3-bff9-621d5b350838"
      }
    },
    "owner": "queueupmusic"
  }
}
