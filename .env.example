# QueueUp Mobile App Configuration

# The base URL of the QueueUp server to connect to.
# This should be a full URL including protocol (https://).
# Default: https://queueup.kingdmvr.com
#
# EXPO_PUBLIC_* values are embedded in the app bundle and are NOT secret.
# Do not put API keys or sensitive credentials here.
EXPO_PUBLIC_API_URL=https://queueup.kingdmvr.com
